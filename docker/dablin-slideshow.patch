+
+void DABlinText::PADChangeSlide(const MOT_FILE& slide) {
+	std::string ext;
+	switch(slide.content_sub_type) {
+	case MOT_FILE::CONTENT_SUB_TYPE_JFIF:
+		ext = "jpg";
+		break;
+	case MOT_FILE::CONTENT_SUB_TYPE_PNG:
+		ext = "png";
+		break;
+	default:
+		return;
+	}
+
+	if(slide.data.empty())
+		return;
+
+	const char* env_dir = getenv("DAB_SLIDES_DIR");
+	std::string dir = (env_dir && *env_dir) ? env_dir : "/tmp/dab-slides";
+	if(mkdir(dir.c_str(), 0755) != 0 && errno != EEXIST) {
+		perror("DABlin: error while creating slides dir");
+		return;
+	}
+
+	std::string tmp_path = dir + "/slide.new." + ext;
+	std::string final_path = dir + "/slide." + ext;
+
+	FILE* f = fopen(tmp_path.c_str(), "wb");
+	if(!f) {
+		fprintf(stderr, "DABlin: cannot open slide file %s\n", tmp_path.c_str());
+		return;
+	}
+	if(fwrite(&slide.data[0], 1, slide.data.size(), f) != slide.data.size())
+		perror("DABlin: error while writing slide file");
+	fclose(f);
+
+	if(rename(tmp_path.c_str(), final_path.c_str()) != 0)
+		perror("DABlin: error while moving slide file");
+	else
+		fprintf(stderr, "DABlin: slideshow saved to %s (%zu bytes)\n", final_path.c_str(), slide.data.size());
+}
